          "_id": "67093bc2f9821a0012345674",
          "title": "مهندسی کامپیوتر"
        },
        "degreeLevel": {
          "_id": "67093bc2f9821a0012345675",
          "title": "کارشناسی"
        },
        "institution": "دانشگاه صنعتی شریف",
        "city": "تهران",
        "startYear": 1395,
        "graduationYear": 1399,
        "gpa": 17.85,
        "description": "پروژه پایانی در زمینه سیستم‌های توزیع‌شده",
        "verificationStatus": "PENDING",
        "verifiedBy": null,
        "verifiedAt": null,
        "rejectionReason": "",
        "verificationLogs": [
          {
            "_id": "67104b2a1a89000012345679",
            "toStatus": "PENDING",
            "changedBy": null,
            "changedAt": "2026-10-18T08:15:00.000Z",
            "comment": "Initial submission - Pending expert verification"
          }
        ],
