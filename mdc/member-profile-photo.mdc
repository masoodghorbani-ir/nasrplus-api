### 5.2 Vue 3 Implementation Example

#### `MemberAvatar.vue`
```vue
<template>
  <div
    class="relative inline-flex items-center justify-center overflow-hidden font-bold select-none"
    :class="[sizeClasses, shapeClasses, backgroundClass]"
  >
    <!-- Member Photo Image -->
    <img
      v-if="fullImageUrl && !imageError"
      :src="fullImageUrl"
      :alt="fullName || 'تصویر عضو'"
      class="w-full h-full object-cover"
      loading="lazy"
      @error="imageError = true"
    />

    <!-- Fallback Initials / Silhouette -->
    <span v-else class="text-slate-600 dark:text-slate-200">
      {{ initials || '---' }}
    </span>

    <!-- Status Badge -->
    <span
      v-if="showStatus && status"
      class="absolute bottom-0 right-0 block rounded-full ring-2 ring-white dark:ring-slate-900"
      :class="[statusSizeClass, statusColorClass]"
      :title="`وضعیت: ${status}`"
    />
  </div>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue';
import { resolvePhotoUrl } from '@/services/member-photo.service';

const props = withDefaults(
  defineProps<{
    profileImage?: string | null;
    fullName?: string;
    status?: 'PENDING' | 'ACTIVE' | 'SUSPENDED' | 'EXPIRED' | 'REJECTED';
    size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'card';
    shape?: 'circle' | 'rounded' | 'portrait';
    showStatus?: boolean;
    timestamp?: number;
  }>(),
  {
    profileImage: '',
    fullName: '',
    size: 'md',
    shape: 'rounded',
    showStatus: false,
    timestamp: 0,
  }
);

const imageError = ref(false);

const fullImageUrl = computed(() => {
  return resolvePhotoUrl(props.profileImage, props.timestamp);
});

const initials = computed(() => {
  if (!props.fullName) return '';
  const parts = props.fullName.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2);
  return `${parts[0][0]} ${parts[parts.length - 1][0]}`;
});

const sizeClasses = computed(() => {
  switch (props.size) {
    case 'xs': return 'w-6 h-6 text-xs';
    case 'sm': return 'w-9 h-9 text-xs';
    case 'md': return 'w-12 h-12 text-sm';
    case 'lg': return 'w-20 h-20 text-lg';
    case 'xl': return 'w-28 h-36 text-xl'; // 3:4 portrait
    case 'card': return 'w-44 h-60 text-2xl'; // ID Card size
    default: return 'w-12 h-12 text-sm';
  }
});

const shapeClasses = computed(() => {
  if (props.size === 'xl' || props.size === 'card' || props.shape === 'portrait') {
    return 'rounded-xl';
  }
  return props.shape === 'circle' ? 'rounded-full' : 'rounded-lg';
});

const backgroundClass = computed(() => {
  return props.profileImage && !imageError.value
    ? 'bg-slate-100'
    : 'bg-slate-200 dark:bg-slate-700';
});

const statusSizeClass = computed(() => {
  return props.size === 'xs' || props.size === 'sm' ? 'w-2 h-2' : 'w-3.5 h-3.5';
});

const statusColorClass = computed(() => {
  switch (props.status) {
    case 'ACTIVE': return 'bg-emerald-500';
    case 'PENDING': return 'bg-amber-500';
    case 'SUSPENDED':
    case 'REJECTED': return 'bg-rose-500';
    default: return 'bg-slate-400';
  }
});
</script>
```

