### 5.3 React Implementation Example (`MemberAvatar.tsx`)

```tsx
import React, { useState } from 'react';
import { resolvePhotoUrl } from '../services/member-photo.service';

interface MemberAvatarProps {
  profileImage?: string | null;
  fullName?: string;
  status?: 'PENDING' | 'ACTIVE' | 'SUSPENDED' | 'EXPIRED' | 'REJECTED';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  shape?: 'circle' | 'rounded' | 'portrait';
  showStatus?: boolean;
  timestamp?: number;
}

export const MemberAvatar: React.FC<MemberAvatarProps> = ({
  profileImage,
  fullName = '',
  status,
  size = 'md',
  shape = 'rounded',
  showStatus = false,
  timestamp,
}) => {
  const [hasError, setHasError] = useState(false);

  const photoUrl = resolvePhotoUrl(profileImage, timestamp);

  const getInitials = (name: string): string => {
    const parts = name.trim().split(/\s+/);
    if (!parts[0]) return '---';
    if (parts.length === 1) return parts[0].slice(0, 2);
    return `${parts[0][0]} ${parts[parts.length - 1][0]}`;
  };

  const sizeClasses = {
    sm: 'w-8 h-8 text-xs',
    md: 'w-12 h-12 text-sm',
    lg: 'w-20 h-20 text-lg',
    xl: 'w-28 h-36 text-xl',
  }[size];

  const shapeClass =
    size === 'xl' || shape === 'portrait'
      ? 'rounded-xl'
      : shape === 'circle'
      ? 'rounded-full'
      : 'rounded-lg';

  const statusBg = {
    ACTIVE: 'bg-emerald-500',
    PENDING: 'bg-amber-500',
    SUSPENDED: 'bg-rose-500',
    REJECTED: 'bg-rose-500',
    EXPIRED: 'bg-slate-400',
  }[status || 'ACTIVE'];

  return (
    <div
      className={`relative inline-flex items-center justify-center overflow-hidden select-none font-bold bg-slate-100 dark:bg-slate-800 ${sizeClasses} ${shapeClass}`}
    >
      {photoUrl && !hasError ? (
        <img
          src={photoUrl}
          alt={fullName || 'تصویر عضو'}
          className="w-full h-full object-cover"
          loading="lazy"
          onError={() => setHasError(true)}
        />
      ) : (
        <span className="text-slate-600 dark:text-slate-300">
          {getInitials(fullName)}
        </span>
      )}

      {showStatus && status && (
        <span
          className={`absolute bottom-0 right-0 w-3 h-3 rounded-full ring-2 ring-white dark:ring-slate-900 ${statusBg}`}
          title={`وضعیت: ${status}`}
        />
      )}
    </div>
  );
};
```

