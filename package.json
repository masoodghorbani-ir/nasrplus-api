  "description": "سامانه مدیریت اعضای سازمان نظام صنفی رایانه‌ای (NasrPlus API)",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:tsc": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
