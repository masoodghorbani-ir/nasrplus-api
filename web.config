<?xml version="1.0" encoding="utf-8"?>
<!-- IIS configuration for Node.js application via iisnode -->
<configuration>
  <system.webServer>
    <!-- Node.js handler mapping -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL rewrite configuration -->
    <rewrite>
      <rules>
        <!-- Do not interfere with node-inspector debugging -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Route all incoming requests to server.js unless it is an existing static file -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security rules to prevent direct file downloads -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- iisnode operational settings -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      devErrorsEnabled="false"
    />

    <defaultDocument enabled="true">
      <files>
        <add value="server.js" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
